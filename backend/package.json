  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:all": "concurrently --names auth,employee,attendance,gateway --prefix-colors auto \"nest start auth\" \"nest start employee\" \"nest start attendance\" \"nest start gateway\"",
